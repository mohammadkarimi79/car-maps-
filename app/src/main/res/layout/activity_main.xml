<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F6F4EF" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/titleText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="پوشه‌نگار" android:textSize="24sp" android:textStyle="bold" android:textColor="#29463E" />
        <Button android:id="@+id/addFolderButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="پوشه جدید" />
    </LinearLayout>
    <TextView android:id="@+id/pathText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="10dp" android:text="پوشه‌های من" android:textColor="#60746D" android:textSize="14sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="20dp">
        <Button android:id="@+id/addImagesButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="افزودن عکس از گالری" />
        <TextView android:id="@+id/foldersHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:text="پوشه‌ها" android:textStyle="bold" android:textSize="17sp" android:textColor="#29463E" />
        <LinearLayout android:id="@+id/foldersContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/imagesHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:text="عکس‌ها" android:textStyle="bold" android:textSize="17sp" android:textColor="#29463E" />
        <GridLayout android:id="@+id/imagesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:alignmentMode="alignMargins" />
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="26dp" android:text="این پوشه هنوز خالی است" android:textColor="#74827D" android:textSize="15sp" />
      </LinearLayout>
    </ScrollView>
</LinearLayout>